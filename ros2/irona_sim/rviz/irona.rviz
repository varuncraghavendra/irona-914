Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 25; 29; 36
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: true
      Cell Size: 0.25
      Plane Cell Count: 40
      Reference Frame: world
    - Class: rviz_default_plugins/RobotModel
      Name: Irona
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF frames
      Enabled: false
      Show Arrows: true
      Show Axes: true
      Show Names: false
    - Class: rviz_default_plugins/PointCloud2
      Name: 360 degree 3D lidar
      Enabled: true
      Topic:
        Value: /irona/lidar/points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Size (Pixels): 2
      Size (m): 0.01
      Style: Points
      Decay Time: 0.2
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
    - Class: rviz_default_plugins/PointCloud2
      Name: D455 depth points
      Enabled: true
      Topic:
        Value: /irona/camera/depth/points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 2
      Size (Pixels): 1
      Size (m): 0.005
      Style: Points
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 36; 192; 215
      Decay Time: 0
    - Class: rviz_default_plugins/Axes
      Name: Vase estimate
      Enabled: true
      Reference Frame: vase_estimate
      Length: 0.25
      Radius: 0.012
    - Class: rviz_default_plugins/Image
      Name: D455 RGB
      Enabled: true
      Topic:
        Value: /irona/camera/color/image_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 2
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: D455 depth
      Enabled: true
      Topic:
        Value: /irona/camera/depth/image_rect_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 2
      Normalize Range: false
      Min Value: 0.3
      Max Value: 4.0
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.7
      Focal Point: {X: 0.1, Y: 0, Z: 0.6}
      Pitch: 0.35
      Yaw: 0.85
      Target Frame: world
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
Window Geometry:
  Width: 1500
  Height: 1000
